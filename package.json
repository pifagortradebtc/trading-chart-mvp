    "@fontsource/instrument-serif": "^5.1.1",
    "immer": "^11.1.4",
    "lightweight-charts": "^4.2.1",
    "lucide-react": "^0.469.0",
    "next": "^15.3.3",
    "plotly.js-dist-min": "^2.35.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-plotly.js": "^2.6.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.60.0",
