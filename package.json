    "test:e2e": "cross-env NODE_OPTIONS=\"--use-system-ca\" playwright test"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.1.1",
    "@fontsource/ibm-plex-mono": "^5.1.1",
